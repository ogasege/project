# Optional. Without a key, Savants runs agents through a local simulator.
ANTHROPIC_API_KEY=
# Needed only when the key is not scoped to a workspace (the API asks for anthropic-workspace-id).
ANTHROPIC_WORKSPACE_ID=
# Optional overrides
SAVANTS_DEFAULT_MODEL=claude-opus-5-5
SAVANTS_FAST_MODEL=claude-haiku-5-5
